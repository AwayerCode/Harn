{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System design v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_root",
    "layers",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "directory",
        "responsibility",
        "allowed_dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "directory": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "responsibility": {
          "type": "string",
          "pattern": "\\S"
        },
        "allowed_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "directory",
        "responsibility",
        "allowed_dependencies",
        "layer",
        "required_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "directory": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "responsibility": {
          "type": "string",
          "pattern": "\\S"
        },
        "allowed_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "required_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
