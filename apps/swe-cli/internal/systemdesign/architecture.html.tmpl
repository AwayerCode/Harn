html,body{height:100%;overflow:hidden}main{height:100vh;height:100dvh;width:100%;max-width:none;margin:0;padding:0;display:flex;flex-direction:column}.canvas{flex:1;min-height:0;height:auto;width:100%}.statusbar{flex:none;display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:0;padding:4px 12px;border-top:1px solid #d4d9e0;background:#f3f4f6;color:#475569;font-size:12px;line-height:24px}.diagram-key{white-space:nowrap}.statusbar .legend{gap:12px;margin:0}.statusbar .zoom-controls{margin:0 0 0 auto;gap:4px;flex-wrap:nowrap}.zoom-controls button{font-size:12px;border:0;border-radius:3px;background:transparent;padding:2px 8px;white-space:nowrap}.zoom-controls button:hover{background:#e0e5ed}.zoom-controls output{min-width:42px}.view-info{position:relative}.view-info summary{cursor:pointer;list-style:none}.view-info>div{position:absolute;right:0;bottom:32px;width:min(400px,90vw);background:white;border:1px solid #cbd5e1;border-radius:6px;padding:12px;box-shadow:0 4px 20px #0002;overflow-wrap:anywhere;z-index:2}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}@media(max-width:700px){.statusbar{gap:4px 12px}.diagram-key{white-space:normal;line-height:18px}.statusbar .legend{flex-wrap:wrap}}@media print{html,body{height:auto;overflow:visible}main{height:auto;display:block}.canvas{height:auto;overflow:visible}.statusbar{display:none}}
.canvas{position:relative;overflow:hidden;touch-action:none;cursor:grab;user-select:none}.canvas.panning{cursor:grabbing}.canvas svg{position:absolute;margin:0}.canvas .node-link{cursor:pointer}@media print{.canvas svg{position:static;left:auto!important;top:auto!important}}
