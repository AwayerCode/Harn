<style>
*{box-sizing:border-box}body{margin:0;background:#fff;color:#242424;font:15px system-ui,sans-serif}main{max-width:1920px;margin:auto;padding:40px}header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}h1{font-size:30px;margin:0 0 8px}p{line-height:1.6;margin:8px 0}.muted{color:#63728a}.legend{display:flex;gap:20px;flex-wrap:wrap}.legend span{white-space:nowrap}.solid{color:#2563a6}.dashed{color:#925119}.canvas{height:clamp(240px,70vh,900px);overflow:auto;background:#fff;border:0;border-radius:0;padding:0}svg{display:block;max-width:none;margin-inline:auto}svg text{stroke:none;font-family:system-ui,sans-serif;fill:#242424;font-size:15px}.band{stroke-width:2;stroke-dasharray:8 6}.color-0{fill:#f5f7ff;stroke:#2853a0}.color-1{fill:#fff8f0;stroke:#925119}.color-2{fill:#f6f1ff;stroke:#6832a5}.color-3{fill:#f0faf6;stroke:#187463}.node{stroke-width:2;fill:#e6edff;stroke:#2853a0}.color-1 .node{fill:#fcebd9;stroke:#925119}.color-2 .node{fill:#ede5fb;stroke:#6832a5}.color-3 .node{fill:#d5f4e9;stroke:#187463}.node-link:hover .node,.node-link:focus .node{stroke:#2563a6;stroke-width:3}.node-title{font-weight:650}.edge{fill:none;stroke-width:2;stroke-linejoin:round}.edge-module{stroke:#2563a6;marker-end:url(#arrow-module)}.edge-layer{stroke:#925119;stroke-dasharray:6 5;marker-end:url(#arrow-layer)}.edge:hover{stroke-width:4}.layer-title{font-weight:650}dialog{width:min(560px,calc(100vw - 32px));max-height:80vh;overflow:auto;border:1px solid #bcc8d8;border-radius:12px;padding:24px;color:#242424}dialog::backdrop{background:rgb(15 23 42 / 35%)}.dialog-close{float:right;font:inherit;cursor:pointer;padding:5px 12px}.detail-link{font:inherit;color:#2563a6;background:none;border:0;cursor:pointer;text-decoration:underline}dialog h2{font-size:20px;margin:0 0 16px;overflow-wrap:anywhere}h3{margin:8px 0}code{overflow-wrap:anywhere;font-size:12px}a{color:#2563a6}footer{font-size:12px;margin-top:20px;color:#63728a;overflow-wrap:anywhere}@media(max-width:700px){main{padding:16px}header{display:block}.legend{margin-top:16px}}@media print{main{padding:0}.zoom-controls{display:none}.canvas{height:auto;overflow:visible;padding:0;border:0}svg{width:100%!important;height:auto!important}dialog{display:none}}

