[data-theme="dark"] .node{fill:#293e60;stroke:#729de3}[data-theme="dark"] .color-1 .node{fill:#4a3627;stroke:#c99a69}[data-theme="dark"] .color-2 .node{fill:#403055;stroke:#aa8bd4}[data-theme="dark"] .color-3 .node{fill:#23493f;stroke:#6db5a3}
[data-theme="dark"] svg.tracing .node-link.related .node{fill:#293e60;stroke:#80b7ff}[data-theme="dark"] svg.tracing .node-link.selected .node{fill:#355580;stroke:#a6cdff}}
body,dialog{background:var(--surface);color:var(--text)}.canvas{background-color:var(--canvas);background-image:radial-gradient(circle at 1px 1px,var(--grid) 1px,transparent 1.2px);background-size:var(--grid-size,24px) var(--grid-size,24px);background-position:var(--grid-x,0px) var(--grid-y,0px)}svg text{fill:var(--text)}.edge-module{stroke:var(--blue)}.edge-layer{stroke:var(--orange)}#arrow-module path{fill:var(--blue)}#arrow-layer path{fill:var(--orange)}.solid,a,.detail-link{color:var(--blue)}.dashed{color:var(--orange)}.muted,.module-path,.detail-count,.module-dependencies summary{color:var(--muted)}.statusbar,.detail-section h3,#detail-content .module-path{background:var(--panel);color:var(--muted);border-color:var(--border)}.zoom-controls button,.dialog-close{color:var(--text)}.zoom-controls button:hover,.dialog-close:hover{background:var(--hover);color:var(--text)}dialog,.dialog-heading,.view-info>div{background:var(--surface);color:var(--text);border-color:var(--border)}#detail-content .detail-section,.interface-item,.file-list li,.module-dependencies{border-color:var(--border)}.column-divider{background:var(--panel)}.column-divider::after{background:var(--border)}.column-divider:hover,.column-divider:focus-visible,.column-divider.resizing{background:var(--blue)}.theme-control{display:flex;align-items:center;gap:6px;white-space:nowrap}.theme-control select{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:2px 5px}@media print{.canvas{background:#fff}}
</style></head><body><main>
<div class="canvas" tabindex="0" aria-label="架构图画布，滚轮缩放，拖拽平移"><svg xmlns="http://www.w3.org/2000/svg" width="{{.Width}}" height="{{.Height}}" viewBox="0 0 {{.Width}} {{.Height}}" role="group" aria-labelledby="diagram-title diagram-desc">
<title id="diagram-title">分层模块架构与允许依赖</title><desc id="diagram-desc">每个虚线分区代表一个层，顶部为层名和职责，区内淡色矩形代表模块。实线箭头表示模块允许依赖，虚线箭头表示层间允许依赖。点击模块查看目录和必要文件。</desc>
<defs><marker id="arrow-module" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#2563a6"/></marker><marker id="arrow-layer" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#925119"/></marker></defs>
{{range .Layers}}<g id="layer-{{.ID}}" class="color-{{.Color}}"><title>{{.ID}}：{{.Responsibility}}</title><rect class="band color-{{.Color}}" x="{{$.BandX}}" y="{{.Y}}" width="{{$.BandWidth}}" height="{{.Height}}" rx="12"/>
{{$layer := .}}{{range $i,$line := .Lines}}<text class="layer-title" x="{{$layer.LabelX}}" y="{{lineY $layer.LabelY $i}}">{{$line}}</text>{{end}}
{{range .Modules}}<a class="node-link" data-module="{{.ID}}" tabindex="0" aria-haspopup="dialog" id="module-{{.ID}}" href="#info-{{.ID}}"><title>{{.ID}}：{{.Responsibility}} · {{.Path}}</title><rect class="node" x="{{.X}}" y="{{.Y}}" width="{{.Width}}" height="{{.Height}}" rx="8"/>
{{$module := .}}{{range $i,$line := .Lines}}<text {{if eq $i 0}}class="node-title"{{end}} text-anchor="middle" x="{{add $module.X 112}}" y="{{lineY $module.Y $i}}">{{$line}}</text>{{end}}</a>{{end}}</g>{{end}}
{{range .Edges}}<path class="edge edge-{{.Kind}}" data-from="{{.From}}" data-to="{{.To}}" d="{{.Path}}"><title>{{.From}} → {{.To}}</title></path>{{end}}
</svg></div>
<p class="sr-only" id="trace-status" role="status" aria-live="polite">悬停或键盘聚焦模块，追踪直接上下游依赖；移开后恢复。点击模块查看详情。</p>
{{range .Layers}}{{range .Modules}}<template id="info-{{.ID}}" data-name="{{.ID}}"><p class="module-path"><code>{{.Path}}/</code></p><div class="detail-columns"><section class="detail-section"><h3>模块功能</h3><div class="column-body"><p>{{.Responsibility}}</p><details class="module-dependencies"><summary>允许依赖</summary><p>{{range .Allowed}}<button class="detail-link" data-detail="{{.}}">→ {{.}}</button> {{else}}无{{end}}</p></details></div></section><div class="column-divider" role="separator" tabindex="0" aria-orientation="vertical" aria-label="模块功能列宽" aria-valuemin="180" aria-valuenow="240" data-divider="0"></div><section class="detail-section"><h3>接口列表 <span class="detail-count">{{len .Interfaces}}</span></h3><div class="column-body">{{range .Interfaces}}<div class="interface-item"><code>{{.Name}}</code><p>{{.Description}}</p></div>{{else}}<p class="muted">尚未声明接口</p>{{end}}</div></section><div class="column-divider" role="separator" tabindex="0" aria-orientation="vertical" aria-label="接口列表列宽" aria-valuemin="180" aria-valuenow="240" data-divider="1"></div><section class="detail-section"><h3>文件列表 <span class="detail-count">{{len .Required}}</span></h3><div class="column-body"><p class="muted">设计声明的必要文件</p><ul class="file-list">{{range .Required}}<li><code>{{.}}</code></li>{{else}}<li class="muted">尚未声明文件</li>{{end}}</ul></div></section></div></template>{{end}}{{end}}
<dialog id="module-dialog" aria-labelledby="module-detail-title"><div class="dialog-heading"><h2 id="module-detail-title"></h2><button class="dialog-close" id="detail-close" aria-label="关闭模块详情" title="关闭（Esc）" autofocus><span aria-hidden="true">×</span></button></div><div id="detail-content"></div></dialog>
<footer class="statusbar" aria-label="架构图工具栏"><div class="zoom-controls" role="group" aria-label="架构图缩放"><button id="zoom-out" aria-label="缩小">−</button><output id="zoom-level" aria-live="polite">100%</output><button id="zoom-in" aria-label="放大">＋</button><button id="zoom-reset">100%</button><button id="zoom-fit">适应全图</button></div><label class="theme-control">主题 <select id="theme-mode" aria-label="配色主题"><option value="auto">自动</option><option value="light">亮色</option><option value="dark">暗色</option></select></label><details class="view-info"><summary>信息</summary><div><p>虚线框：职责边界<br>箭头：依赖方 → 被依赖方<br><span class="solid">蓝色实线：模块允许依赖</span><br><span class="dashed">橙色虚线：层间允许依赖</span></p></div></details></footer>
</main>
<script type="application/javascript">
(() => {
  const svg = document.querySelector('.canvas svg');
  const nodes = Array.from(svg.querySelectorAll('.node-link'));
  const edges = Array.from(svg.querySelectorAll('.edge'));
  const status = document.getElementById('trace-status');
  const idle = status.textContent;
  let hovered = null;
  let focused = null;
  function update() {
    const id = hovered || focused;
    const related = new Set(id ? [id] : []);
    const upstream = new Set();
    const downstream = new Set();
    for (const edge of edges) {
      const moduleEdge = edge.classList.contains('edge-module');
      const from = edge.dataset.from;
      const to = edge.dataset.to;
      const active = Boolean(id && moduleEdge && (from === id || to === id));
      edge.classList.toggle('related', active);
      if (active) {
        related.add(from);
        related.add(to);
        if (to === id) upstream.add(from);
        if (from === id) downstream.add(to);
      }
    }
    svg.classList.toggle('tracing', Boolean(id));
    for (const node of nodes) {
      node.classList.toggle('related', related.has(node.dataset.module));
      node.classList.toggle('selected', node.dataset.module === id);
    }
    status.textContent = id
      ? id + '：' + upstream.size + ' 个上游模块依赖它，依赖 ' + downstream.size + ' 个下游模块。仅高亮直接关系。'
      : idle;
  }
  for (const node of nodes) {
    const id = node.dataset.module;
    node.addEventListener('pointerenter', () => { hovered = id; update(); });
    node.addEventListener('pointerleave', () => { if (hovered === id) hovered = null; update(); });
    node.addEventListener('focus', () => { focused = id; update(); });
    node.addEventListener('blur', () => { if (focused === id) focused = null; update(); });
  }
})();
</script>
<script type="application/javascript">
(() => {
  const canvas = document.querySelector('.canvas');
  const svg = canvas.querySelector('svg');
  const width = svg.viewBox.baseVal.width;
  const height = svg.viewBox.baseVal.height;
  const level = document.getElementById('zoom-level');
  let scale = 1;
  let fitting = true;
  let offsetX = 0, offsetY = 0;
  function apply(next, fit, x = canvas.clientWidth / 2, y = canvas.clientHeight / 2) {
    const worldX = (x - offsetX) / scale;
    const worldY = (y - offsetY) / scale;
    scale = next;
    fitting = fit;
    offsetX = fit ? (canvas.clientWidth - width * scale) / 2 : x - worldX * scale;
    offsetY = fit ? (canvas.clientHeight - height * scale) / 2 : y - worldY * scale;
    svg.style.width = width * scale + 'px';
    svg.style.height = height * scale + 'px';
    position();
    level.textContent = Math.round(scale * 100) + '%';
  }
  function position() {
    svg.style.left = offsetX + 'px';
    svg.style.top = offsetY + 'px';
    // Keep grid lines legible at low zoom, anchored to diagram coordinates.
    let spacing = 24 * scale;
    while (spacing < 12) spacing *= 2;
    canvas.style.setProperty('--grid-size', spacing + 'px');
    canvas.style.setProperty('--grid-x', offsetX + 'px');
    canvas.style.setProperty('--grid-y', offsetY + 'px');
  }
  function fit() {
    apply(Math.min(1, Math.max(1, canvas.clientWidth - 16) / width,
      Math.max(1, canvas.clientHeight - 16) / height), true);
  }
  document.getElementById('zoom-in').addEventListener('click', () => apply(Math.min(3, scale * 1.25), false));
  document.getElementById('zoom-out').addEventListener('click', () => apply(Math.max(Math.min(scale, 0.05), scale / 1.25), false));
  document.getElementById('zoom-reset').addEventListener('click', () => apply(1, false));
  document.getElementById('zoom-fit').addEventListener('click', fit);
  canvas.addEventListener('wheel', event => {
    event.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const delta = event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? canvas.clientHeight : 1);
    const next = Math.min(3, Math.max(Math.min(scale, 0.05), scale * Math.exp(-Math.max(-500, Math.min(500, delta)) * 0.002)));
    apply(next, false, event.clientX - rect.left, event.clientY - rect.top);
  }, {passive:false});
  let drag = null, suppressClick = false;
  canvas.addEventListener('pointerdown', event => {
    if (event.button !== 0 || !event.isPrimary) return;
    suppressClick = false;
    drag = {id:event.pointerId, x:event.clientX, y:event.clientY, ox:offsetX, oy:offsetY, moved:false};
  });
  canvas.addEventListener('pointermove', event => {
    if (!drag || drag.id !== event.pointerId) return;
    const dx = event.clientX - drag.x, dy = event.clientY - drag.y;
    if (!drag.moved && Math.hypot(dx, dy) < 4) return;
    drag.moved = true;
    suppressClick = true;
    fitting = false;
    canvas.setPointerCapture(event.pointerId);
    canvas.classList.toggle('panning', true);
    offsetX = drag.ox + dx; offsetY = drag.oy + dy;
    position();
    event.preventDefault();
  });
  function endDrag(event) {
    if (!drag || drag.id !== event.pointerId) return;
    drag = null;
    canvas.classList.toggle('panning', false);
    if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
  }
  canvas.addEventListener('pointerup', endDrag);
  canvas.addEventListener('pointercancel', endDrag);
  canvas.addEventListener('lostpointercapture', endDrag);
  canvas.addEventListener('click', event => {
    if (suppressClick && event.detail !== 0) {
      event.preventDefault(); event.stopImmediatePropagation(); suppressClick = false;
    }
  }, true);
  canvas.addEventListener('dragstart', event => event.preventDefault());
  new ResizeObserver(() => { if (fitting) fit(); }).observe(canvas);
  fit();
})();
</script>
<script type="application/javascript">
(() => {
  const dialog = document.getElementById('module-dialog');
  const content = document.getElementById('detail-content');
  let opener;
  function show(id) {
    const template = document.getElementById('info-' + id);
    if (!template) return;
    document.getElementById('module-detail-title').textContent = template.dataset.name;
    content.replaceChildren(template.content.cloneNode(true));
    content.scrollTop = 0;
    if (!dialog.open) dialog.showModal();
  }
  for (const node of document.querySelectorAll('.node-link')) {
    node.addEventListener('click', event => {
      event.preventDefault();
      opener = node;
      show(node.dataset.module);
    });
  }
  content.addEventListener('click', event => {
    const link = event.target.closest('[data-detail]');
    if (link) show(link.dataset.detail);
  });
  document.getElementById('detail-close').addEventListener('click', () => dialog.close());
  function outside(event) {
    const rect = dialog.getBoundingClientRect();
    return event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom);
  }
  let backdropPress = false;
  dialog.addEventListener('pointerdown', event => { backdropPress = outside(event); });
  dialog.addEventListener('click', event => {
    if (backdropPress && outside(event)) dialog.close();
    backdropPress = false;
  });
  dialog.addEventListener('close', () => { if (opener) opener.focus({preventScroll:true}); });
})();
</script>
<script type="application/javascript">
(() => {
  const content = document.getElementById('detail-content');
  let drag = null;
  function geometry(handle) {
    const grid = handle.parentElement;
    const widths = Array.from(grid.querySelectorAll('.detail-section'), node => node.getBoundingClientRect().width);
    return {grid, widths, index:Number(handle.dataset.divider)};
  }
  function resize(handle, state, delta) {
    const widths = state.widths.slice();
    const i = state.index, total = widths[i] + widths[i + 1];
    widths[i] = Math.max(180, Math.min(total - 180, widths[i] + delta));
    widths[i + 1] = total - widths[i];
    state.grid.style.gridTemplateColumns = widths.map(w => w + 'px').join(' 7px ');
    handle.setAttribute('aria-valuenow', Math.round(widths[i]));
    handle.setAttribute('aria-valuemax', Math.round(total - 180));
  }
  content.addEventListener('pointerdown', event => {
    const handle = event.target.closest('.column-divider');
    if (!handle || event.button !== 0 || !event.isPrimary) return;
    event.preventDefault();
    handle.focus({preventScroll:true});
    drag = {...geometry(handle), handle, id:event.pointerId, start:event.clientX};
    handle.setPointerCapture(event.pointerId);
    handle.classList.add('resizing');
    drag.grid.classList.add('resizing');
  });
  content.addEventListener('pointermove', event => {
    if (!drag || event.pointerId !== drag.id) return;
    resize(drag.handle, drag, event.clientX - drag.start);
  });
  function finish(event) {
    if (!drag || (event.pointerId !== undefined && event.pointerId !== drag.id)) return;
    const {handle, grid, id} = drag;
    drag = null;
    handle.classList.remove('resizing'); grid.classList.remove('resizing');
    if (handle.hasPointerCapture(id)) handle.releasePointerCapture(id);
  }
  for (const type of ['pointerup','pointercancel','lostpointercapture']) content.addEventListener(type, finish);
  document.getElementById('module-dialog').addEventListener('close', finish);
  content.addEventListener('keydown', event => {
    const handle = event.target.closest('.column-divider');
    if (!handle || !['ArrowLeft','ArrowRight'].includes(event.key)) return;
    event.preventDefault();
    resize(handle, geometry(handle), (event.key === 'ArrowLeft' ? -1 : 1) * (event.shiftKey ? 40 : 10));
  });
})();
</script>
<script type="application/javascript">
(() => {
  const select = document.getElementById('theme-mode');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const valid = value => ['auto','light','dark'].includes(value);
  try { const saved = localStorage.getItem('harn-diagram-theme'); if (valid(saved)) select.value = saved; } catch {}
  function apply() {
    document.documentElement.dataset.theme = select.value === 'auto' ? (system.matches ? 'dark' : 'light') : select.value;
  }
  select.addEventListener('change', () => {
    if (!valid(select.value)) select.value = 'auto';
    try { localStorage.setItem('harn-diagram-theme', select.value); } catch {}
    apply();
  });
  system.addEventListener('change', apply);
  apply();
})();
</script>
</body></html>
