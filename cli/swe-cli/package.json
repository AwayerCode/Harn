{
  "name": "@harn/swe-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Single-check SWE core and standalone runtime prototype",
  "engines": {
    "node": "22.22.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/core.test.cjs",
    "package": "node scripts/package.mjs",
    "test:binary": "node --test test/binary.test.cjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
